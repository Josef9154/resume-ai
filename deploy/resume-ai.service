[Unit]
Description=Joseph Rochelle Resume AI
After=network-online.target ollama.service
[Service]
User=resumeai
Group=resumeai
WorkingDirectory=/srv/resume-ai/current
EnvironmentFile=/etc/resume-ai.env
ExecStart=/srv/resume-ai/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8200 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
MemoryMax=384M
CPUQuota=50%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
